{
  "manifest_version": 3,
  "name": "RailOxide Gateway",
  "version": "0.1.0",
  "key": "",
  "description": "RailOxide desktop gateway and EIP-1193 provider.",
  "icons": {
    "16": "assets/branding/16x16.png",
    "32": "assets/branding/32x32.png",
    "48": "assets/branding/48x48.png",
    "128": "assets/branding/128x128.png"
  },
  "action": {
    "default_icon": {
      "16": "assets/branding/16x16.png",
      "32": "assets/branding/32x32.png",
      "48": "assets/branding/48x48.png",
      "128": "assets/branding/128x128.png"
    },
    "default_title": "RailOxide Gateway",
    "default_popup": "index.html"
  },
  "side_panel": {
    "default_path": "index.html?mode=sidepanel"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' ws: wss:; style-src 'self'; img-src 'self'; font-src 'self'"
  },
  "minimum_chrome_version": "120",
  "background": {
    "service_worker": "gateway-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "alarms",
    "webNavigation"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "gateway-provider.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN",
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "gateway-content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED",
      "match_origin_as_fallback": true
    }
  ]
}
