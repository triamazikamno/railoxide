#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"
bundle_root="$repo_root/target/macos"
app_name="RailOxide"
app_bundle="$bundle_root/$app_name.app"
dmg_staging_dir="$bundle_root/dmg"
dmg_path="$bundle_root/$app_name.dmg"
contents_dir="$app_bundle/Contents"
macos_dir="$contents_dir/MacOS"
resources_dir="$contents_dir/Resources"
binary_src="$repo_root/target/release/wallet"
binary_dst="$macos_dir/$app_name"
plist_src="$repo_root/bins/wallet/packaging/macos/Info.plist"
icon_src="$repo_root/bins/wallet/packaging/icons/macos/RailOxide.icns"
libusb_license_src="$repo_root/bins/wallet/packaging/macos/libusb-LICENSE-LGPL-2.1.txt"
release_dir="$bundle_root/release"
codesign_identity="${CODESIGN_IDENTITY:--}"
cargo_features="${CARGO_FEATURES-hardware}"
cargo_bin="${CARGO_BIN:-cargo}"
cargo_toolchain="${CARGO_TOOLCHAIN:-}"
macos_minimum_version="${MACOS_MINIMUM_VERSION:-}"

require_tool() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf 'missing required tool: %s\n' "$1" >&2
    exit 1
  fi
}

require_tool "$cargo_bin"
require_tool codesign
require_tool ditto
require_tool hdiutil
require_tool plutil
require_tool python3
if [[ -n "$macos_minimum_version" ]]; then
  require_tool lipo
  require_tool otool
fi

if [[ -n "$macos_minimum_version" && ! "$macos_minimum_version" =~ ^[0-9]+\.[0-9]+$ ]]; then
  printf 'invalid MACOS_MINIMUM_VERSION: %s\n' "$macos_minimum_version" >&2
  exit 1
fi

if [[ "$(uname -s)" != "Darwin" ]]; then
  printf 'macOS app packaging requires macOS\n' >&2
  exit 1
fi

if [[ ! -f "$plist_src" ]]; then
  printf 'missing Info.plist: %s\n' "$plist_src" >&2
  exit 1
fi

if [[ ! -f "$icon_src" ]]; then
  printf 'missing app icon: %s\n' "$icon_src" >&2
  exit 1
fi

version="$(python3 "$script_dir/macos-packaging.py" version)"
bundle_version="$(python3 "$script_dir/macos-packaging.py" version --bundle)"

cargo_command=("$cargo_bin")
if [[ -n "$cargo_toolchain" ]]; then
  cargo_command+=("+$cargo_toolchain")
fi

cd "$repo_root"
CARGO_BIN="$cargo_bin" CARGO_TOOLCHAIN="$cargo_toolchain" "$script_dir/build-browser-extension"
export RAILOXIDE_EXTENSION_BUNDLE="$repo_root/target/browser-extension.zip"
[[ -s "$RAILOXIDE_EXTENSION_BUNDLE" ]] || { printf 'extension build did not produce a ZIP\n' >&2; exit 1; }

if [[ -n "$macos_minimum_version" ]]; then
  export MACOSX_DEPLOYMENT_TARGET="$macos_minimum_version"
fi
if [[ -n "$cargo_features" ]]; then
  "${cargo_command[@]}" build --release --locked -p wallet --features "$cargo_features"
else
  "${cargo_command[@]}" build --release --locked -p wallet
fi
python3 "$script_dir/verify-browser-extension.py" "$binary_src" "$RAILOXIDE_EXTENSION_BUNDLE"

rm -rf "$app_bundle"
mkdir -p "$macos_dir" "$resources_dir"

cp "$binary_src" "$binary_dst"
cp "$plist_src" "$contents_dir/Info.plist"
cp "$icon_src" "$resources_dir/RailOxide.icns"
chmod 755 "$binary_dst"
if [[ ",${cargo_features// /}," == *,hardware,* ]]; then
  cp "$libusb_license_src" "$resources_dir/libusb-LICENSE-LGPL-2.1.txt"
fi

plist_dst="$contents_dir/Info.plist"
plutil -replace CFBundleShortVersionString -string "$bundle_version" "$plist_dst"
plutil -replace CFBundleVersion -string "$bundle_version" "$plist_dst"
if [[ -n "$macos_minimum_version" ]]; then
  plutil -replace LSMinimumSystemVersion -string "$macos_minimum_version" "$plist_dst"
fi
plutil -lint "$plist_dst"
bundle_identifier="$(plutil -extract CFBundleIdentifier raw "$plist_dst")"
if [[ "$bundle_identifier" != "app.railoxide.wallet" ]]; then
  printf 'unexpected bundle identifier: %s\n' "$bundle_identifier" >&2
  exit 1
fi

if [[ -n "$macos_minimum_version" ]]; then
  binary_archs="$(lipo -archs "$binary_dst")"
  if [[ "$binary_archs" != "arm64" ]]; then
    printf 'expected an arm64-only binary, found: %s\n' "$binary_archs" >&2
    exit 1
  fi
  # awk reads all input; exiting early could SIGPIPE otool and fail the pipeline.
  binary_minos="$(otool -l "$binary_dst" | awk '$1 == "cmd" { build = ($2 == "LC_BUILD_VERSION") } build && $1 == "minos" && !found { print $2; found = 1 }')"
  if [[ "$binary_minos" != "$macos_minimum_version" ]]; then
    printf 'expected minimum macOS %s, found: %s\n' "$macos_minimum_version" "${binary_minos:-none}" >&2
    exit 1
  fi
  python3 "$script_dir/macos-packaging.py" check-linkage "$app_bundle"
fi

codesign --force --deep --sign "$codesign_identity" "$app_bundle"
codesign --verify --deep --strict --verbose=2 "$app_bundle"

rm -rf "$dmg_staging_dir" "$dmg_path"
mkdir -p "$dmg_staging_dir"
ditto "$app_bundle" "$dmg_staging_dir/$app_name.app"
ln -s /Applications "$dmg_staging_dir/Applications"

hdiutil create \
  -volname "$app_name" \
  -srcfolder "$dmg_staging_dir" \
  -ov \
  -format UDZO \
  "$dmg_path"
hdiutil verify "$dmg_path"

printf 'packaged %s\n' "$app_bundle"
printf 'packaged %s\n' "$dmg_path"

if [[ -n "$macos_minimum_version" ]]; then
  release_dmg="RailOxide-v$version-macos-arm64.dmg"
  release_sums="RailOxide-v$version-macos-SHA256SUMS"
  rm -rf "$release_dir"
  mkdir -p "$release_dir"
  cp "$dmg_path" "$release_dir/$release_dmg"
  (cd "$release_dir" && shasum -a 256 "$release_dmg" > "$release_sums")
  printf 'packaged %s\n' "$release_dir/$release_dmg"
  printf 'packaged %s\n' "$release_dir/$release_sums"
fi
