#!/usr/bin/env python3
"""Promote the verified railoxide Homebrew cask of the latest release into triamazikamno/tap.

Runs on the maintainer's Mac with their own gh login and git credentials.
See "Promoting the Homebrew cask" in docs/releasing.md.
"""

import argparse
import hashlib
import importlib.util
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile

REPO = 'triamazikamno/railoxide'
TAP = 'triamazikamno/tap'
CASK = 'Casks/railoxide.rb'
DOWNLOAD = f'https://github.com/{REPO}/releases/download'
PUBLIC_KEY = 'https://triamazikamno.github.io/railoxide/flatpak/flatpak-release-public.gpg'
URL_LINE = (f'  url "{DOWNLOAD}/v#{{version}}/RailOxide-v#{{version}}-macos-arm64.dmg"')

# Reuse the version and checksum rules that rendered the cask.
_spec = importlib.util.spec_from_file_location(
    'macos_packaging', Path(__file__).resolve().with_name('macos-packaging.py'))
packaging = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(packaging)


class Error(Exception):
    pass


def run(*args, cwd=None, capture=False):
    try:
        result = subprocess.run(args, cwd=cwd, stdout=subprocess.PIPE if capture else None, text=True)
    except FileNotFoundError:
        raise Error(f'{args[0]} is required') from None
    if result.returncode != 0:
        raise Error(f'{" ".join(args[:3])} failed with status {result.returncode}')
    return result.stdout


def version_key(version):
    """SemVer precedence; build metadata after '+' is ignored."""
    core, _, pre = version.split('+', 1)[0].partition('-')
    numbers = tuple(int(part) for part in core.split('.'))
    if not pre:
        return numbers + (1, [])
    return numbers + (0, [(0, int(p), '') if p.isdigit() else (1, 0, p) for p in pre.split('.')])


def checked_version(version):
    if packaging.VERSION_PATTERN.fullmatch(version) is None:
        raise Error(f'unsupported version: {version!r}')
    return version


def latest_tag():
    releases = json.loads(run('gh', 'api', f'repos/{REPO}/releases?per_page=100', capture=True))
    published = [r for r in releases if not r['draft'] and r.get('published_at')]
    if not published:
        raise Error('no published release found')
    return max(published, key=lambda r: (r['published_at'], r['id']))['tag_name']


def verify_release(tag, workdir):
    dmg_name = f'RailOxide-{tag}-macos-arm64.dmg'
    sums_name = f'RailOxide-{tag}-macos-SHA256SUMS'
    files = {name: workdir / name for name in (dmg_name, sums_name, sums_name + '.asc')}
    for name, path in files.items():
        run('curl', '-fsSL', '-o', str(path), f'{DOWNLOAD}/{tag}/{name}')
    key = workdir / 'release-public.gpg'
    run('curl', '-fsSL', '-o', str(key), PUBLIC_KEY)
    # Short path: gpg's sockets live in the homedir, and macOS's $TMPDIR exceeds the socket path limit.
    homedir = tempfile.mkdtemp(prefix='roxgpg-', dir='/tmp')
    try:
        imported = subprocess.run(['gpg', '--batch', '--homedir', homedir, '--import', '--', str(key)],
                                  stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
        if imported.returncode != 0:
            raise Error(f'could not import the release public key:\n{imported.stderr.strip()}')
        verified = subprocess.run(['gpg', '--batch', '--homedir', homedir, '--verify', '--',
                                   str(files[sums_name + '.asc']), str(files[sums_name])],
                                  stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
        if verified.returncode != 0:
            raise Error(f'{sums_name}.asc is not a valid signature by the release key:\n'
                        f'{verified.stderr.strip()}')
    finally:
        subprocess.run(['gpgconf', '--homedir', homedir, '--kill', 'all'],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        shutil.rmtree(homedir, ignore_errors=True)
    try:
        digest = packaging.dmg_digest(files[sums_name], dmg_name)
    except packaging.PackagingError as error:
        raise Error(str(error)) from None
    sha = hashlib.sha256()
    with open(files[dmg_name], 'rb') as dmg:
        for chunk in iter(lambda: dmg.read(1 << 20), b''):
            sha.update(chunk)
    if sha.hexdigest() != digest:
        raise Error(f'{dmg_name} does not match its signed checksum')
    return digest


def fetch_cask(tag, version, digest, workdir):
    runs = json.loads(run('gh', 'run', 'list', '--repo', REPO, '--workflow', 'macos-release.yml',
                          '--event', 'release', '--branch', tag, '--status', 'success',
                          '--json', 'databaseId', '--limit', '1', capture=True))
    if not runs:
        raise Error(f'no successful macOS release run for {tag}')
    directory = workdir / 'cask'
    run('gh', 'run', 'download', str(runs[0]['databaseId']), '--repo', REPO,
        '--name', 'railoxide-cask', '--dir', str(directory))
    cask = (directory / 'railoxide.rb').read_text()
    lines = cask.splitlines()
    for field, expected in [('version', f'  version "{version}"'), ('sha256', f'  sha256 "{digest}"'),
                            ('url', URL_LINE)]:
        if [line for line in lines if line.strip().startswith(field + ' ')] != [expected]:
            raise Error(f'cask {field} does not match the verified release')
    return cask


def tap_version(cask):
    match = re.search(r'^\s*version "([^"]+)"$', cask, re.MULTILINE)
    if match is None:
        raise Error('cannot read the version of the cask in the tap')
    return checked_version(match.group(1))


def promote(tag):
    latest = latest_tag()
    if tag is None:
        tag = latest
    elif tag != latest:
        raise Error(f'{tag} is not the latest release ({latest})')
    if not tag.startswith('v'):
        raise Error(f'unsupported release tag: {tag!r}')
    version = checked_version(tag[1:])
    print(f'promoting {tag}')

    with tempfile.TemporaryDirectory(prefix='promote-homebrew-cask-') as temporary:
        workdir = Path(temporary)
        digest = verify_release(tag, workdir)
        print(f'verified release assets: sha256 {digest}')
        cask = fetch_cask(tag, version, digest, workdir)
        print('downloaded the verified cask')

    tap = Path(run('brew', '--repository', TAP, capture=True).strip())
    if not tap.is_dir():
        try:
            run('brew', 'tap', TAP)
        except Error:
            raise Error(f'could not tap {TAP}; create triamazikamno/homebrew-tap as described '
                        'in docs/releasing.md') from None
    if run('git', 'status', '--porcelain', cwd=tap, capture=True):
        raise Error(f'{tap} has uncommitted changes')
    run('git', 'pull', '-q', '--ff-only', cwd=tap)

    target = tap / CASK
    previous = target.read_text() if target.exists() else None
    if previous == cask:
        print(f'railoxide {version} is already promoted')
        return
    if previous is not None:
        current = tap_version(previous)
        if version_key(current) >= version_key(version):
            raise Error(f'the tap has railoxide {current}, which is not older than {version}')

    created_dir = not target.parent.exists()
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(cask)
    committed = False
    try:
        run('brew', 'style', '--cask', f'{TAP}/railoxide')
        run('brew', 'audit', '--cask', f'{TAP}/railoxide')
        if previous is None:
            print(cask, end='')
        else:
            run('git', '--no-pager', 'diff', '--', CASK, cwd=tap)
        try:
            answer = input(f'Commit and push railoxide {version} to the tap? [y/N] ')
        except EOFError:
            answer = ''
        if answer.strip().lower() not in ('y', 'yes'):
            raise Error('declined')
        run('git', 'add', '--', CASK, cwd=tap)
        run('git', 'commit', '-q', '-m', f'railoxide {version}', cwd=tap)
        committed = True
    finally:
        if not committed:
            subprocess.run(['git', 'reset', '-q', '--', CASK], cwd=tap,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if previous is None:
                target.unlink()
                if created_dir:
                    shutil.rmtree(target.parent, ignore_errors=True)
            else:
                target.write_text(previous)
            print('nothing was promoted; the tap is unchanged', file=sys.stderr)
    try:
        run('git', 'push', '-q', cwd=tap)
    except Error:
        raise Error(f'the commit is local in {tap}; push it by hand') from None
    print(f'promoted railoxide {version} to {TAP}')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('tag', nargs='?', help='release tag; must be the latest release (default)')
    args = parser.parse_args()
    try:
        promote(args.tag)
    except Error as error:
        print(f'error: {error}', file=sys.stderr)
        sys.exit(1)


if __name__ == '__main__':
    main()
